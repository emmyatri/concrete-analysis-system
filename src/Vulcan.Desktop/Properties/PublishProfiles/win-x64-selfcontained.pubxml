<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained Windows build (SCRUM-108, NFR-1): the app brings its own .NET runtime, so Vulcan's
  computer doesn't need .NET installed. Used by CI and the installer (installer/vulcan.iss).

    dotnet publish src/Vulcan.Desktop -p:PublishProfile=win-x64-selfcontained

  A folder, not a single .exe: WebView2 and SQLite ship native DLLs that need to sit next to the program.
-->
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>
        <PublishDir>bin\publish\win-x64\</PublishDir>
        <PublishProtocol>FileSystem</PublishProtocol>
        <!-- Vulcan.Api is also a runnable program (Program.cs, used by its tests), but here it's only loaded
        in-process as a library, so it doesn't need its own runtime. -->
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    </PropertyGroup>
</Project>
